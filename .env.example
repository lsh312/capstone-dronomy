# Copy this file to .env and fill in your credentials
# Never commit .env to git

# Google Maps Static API key
# Get it at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable "Maps Static API" in your project first
MAPS_API_KEY=your_google_maps_static_api_key_here

# Google Earth Engine project ID
# Register at: https://earthengine.google.com/
# After registration, create a project and paste its ID here (e.g. "my-ee-project-123")
# Then run once in terminal: earthengine authenticate
EE_PROJECT=your_earth_engine_project_id_here
