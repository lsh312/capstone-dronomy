    "            'frame_idx': fi, 'path': frame_paths[fi],\n",
    "            'cum_x': float(row['cum_x']), 'cum_y': float(row['cum_y']), 'cum_yaw': float(row['cum_yaw']),\n",
    "            'dx': float(row['dx']), 'dy': float(row['dy']), 'dyaw': float(row['dyaw']),\n",
    "            'good_matches': int(row['good_matches']), 'inliers': int(row['inliers']),\n",
    "            'inlier_ratio': float(row['inlier_ratio']), 'mean_score': float(row['mean_score']),\n",
    "        })\n",
    "print(f'Loaded {len(vo_records)} VO records')\n"
   ]
  },
