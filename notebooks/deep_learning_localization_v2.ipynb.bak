    "    ax2.set_title('Satellite overlay')\n",
    "\n",
    "plt.suptitle('Visual Odometry Trajectory (SuperPoint + LightGlue)', fontsize=13)\n",
    "plt.tight_layout()\n",
    "fig.savefig(RESULTS_DIR / 'trajectory.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
