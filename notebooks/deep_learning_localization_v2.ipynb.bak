   "cell_type": "markdown",
   "id": "cell8-md",
   "metadata": {},
   "source": [
    "---\n",
    "## Cell 8 — Scale Calibration: Pixels → Meters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "cell8-code",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Scale estimates (m/px): ['0.0059', '0.0112', '1.2879']\n",
      "Median scale: 0.0112 m/px\n",
      "Implied drone footprint width: ~7 m\n"
     ]
    }
   ],
   "source": [
    "def haversine_m(lat1, lon1, lat2, lon2):\n",
    "    R = 6371000\n",
    "    phi1, phi2 = math.radians(lat1), math.radians(lat2)\n",
    "    dphi  = math.radians(lat2 - lat1)\n",
    "    dlam  = math.radians(lon2 - lon1)\n",
    "    a = math.sin(dphi/2)**2 + math.cos(phi1)*math.cos(phi2)*math.sin(dlam/2)**2\n",
    "    return R * 2 * math.atan2(math.sqrt(a), math.sqrt(1-a))\n",
    "\n",
    "scale_m_per_px = None\n",
    "\n",
    "if len(anchors) >= 2:\n",
    "    scales = []\n",
    "    for i in range(len(anchors) - 1):\n",
    "        a0, a1 = anchors[i], anchors[i+1]\n",
    "        gps_dist_m = haversine_m(a0['est_lat'], a0['est_lon'],\n",
    "                                  a1['est_lat'], a1['est_lon'])\n",
    "        vo_dist_px = math.hypot(a1['vo_cum_x'] - a0['vo_cum_x'],\n",
    "                                 a1['vo_cum_y'] - a0['vo_cum_y'])\n",
    "        if vo_dist_px > 1:\n",
    "            scales.append(gps_dist_m / vo_dist_px)\n",
    "    if scales:\n",
    "        scale_m_per_px = float(np.median(scales))\n",
    "        print(f'Scale estimates (m/px): {[f\"{s:.4f}\" for s in scales]}')\n",
    "        print(f'Median scale: {scale_m_per_px:.4f} m/px')\n",
    "        print(f'Implied drone footprint width: ~{scale_m_per_px * DOWNSAMPLE_SIZE[0]:.0f} m')\n",
    "elif mpp_sat is not None:\n",
    "    scale_m_per_px = mpp_sat\n",
    "    print(f'Only {len(anchors)} anchor(s) -- using satellite m/px as fallback: '\n",
    "          f'{scale_m_per_px:.4f} m/px')\n",
    "else:\n",
    "    print('Cannot estimate scale -- no satellite anchors available')\n",
    "    scale_m_per_px = 1.0"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell9-md",
   "metadata": {},
   "source": [
    "---\n",
    "## Cell 9 — Drift Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "cell9-code",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " Frame      GPS lat      GPS lon  VO East (m) VO North (m)  Drift (m)  Time (s)\n",
      "--------------------------------------------------------------------------------\n",
      "  2175    43.521572    -5.624620         -0.4        -38.7       56.4     145.0\n",
      "  2700    43.521664    -5.624595         -0.5        -49.1       76.9     180.0\n",
      "  2715    43.521683    -5.624669         -0.5        -49.1       78.1     181.0\n",
      "\n",
      "Drift after 181.0s: 78.1 m  (0.43 m/s drift rate)\n"
     ]
    }
   ],
   "source": [
    "drift_records = []\n",
    "\n",
    "if len(anchors) < 2:\n",
    "    print('Need >= 2 anchors to evaluate drift')\n",
    "else:\n",
    "    a0 = anchors[0]\n",
    "    origin_lat, origin_lon   = a0['est_lat'], a0['est_lon']\n",
    "    origin_vo_x, origin_vo_y = a0['vo_cum_x'], a0['vo_cum_y']\n",
    "\n",
    "    print(f'{\"Frame\":>6} {\"GPS lat\":>12} {\"GPS lon\":>12} '\n",
    "          f'{\"VO East (m)\":>12} {\"VO North (m)\":>12} {\"Drift (m)\":>10} {\"Time (s)\":>9}')\n",
    "    print('-' * 80)\n",
    "\n",
    "    for a in anchors[1:]:\n",
    "        gps_north = (a['est_lat'] - origin_lat) * 111320\n",
    "        gps_east  = (a['est_lon'] - origin_lon) * 111320 * math.cos(math.radians(LAT))\n",
    "\n",
    "        vo_dx_m  = (a['vo_cum_x'] - origin_vo_x) * scale_m_per_px\n",
    "        vo_dy_m  = (a['vo_cum_y'] - origin_vo_y) * scale_m_per_px\n",
    "        vo_east  =  vo_dx_m\n",
    "        vo_north = -vo_dy_m\n",
    "\n",
    "        drift_m = math.hypot(gps_east - vo_east, gps_north - vo_north)\n",
    "        time_s  = a['frame_idx'] / 15.0\n",
    "\n",
    "        drift_records.append({'time_s': time_s, 'drift_m': drift_m,\n",
    "                               'gps_east': gps_east, 'gps_north': gps_north,\n",
    "                               'vo_east': vo_east, 'vo_north': vo_north})\n",
    "        print(f\"{a['frame_idx']:>6} {a['est_lat']:>12.6f} {a['est_lon']:>12.6f} \"\n",
    "              f\"{vo_east:>12.1f} {vo_north:>12.1f} {drift_m:>10.1f} {time_s:>9.1f}\")\n",
    "\n",
    "    if drift_records:\n",
    "        max_t = drift_records[-1]['time_s']\n",
    "        max_d = drift_records[-1]['drift_m']\n",
    "        if max_t > 0:\n",
    "            print(f'\\nDrift after {max_t:.1f}s: {max_d:.1f} m  ({max_d/max_t:.2f} m/s drift rate)')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 9b — GPS Ground-Truth Benchmark (DJI .SRT)\n",
    "\n",
    "Scores the satellite anchors against the drone's on-board DJI GPS track\n",
    "(`data/gps_data.SRT`). This is the real positioning-error benchmark: anchor\n",
    "quality measured in metres against truth, not \"distance from a single nominal\n",
    "point\". The harness is matcher-agnostic, so the same call scores SIFT / SURF /\n",
    "LightGlue / MatchAnything runs on equal footing."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys, importlib\n",
    "sys.path.append('../code')\n",
    "import gps_benchmark as gpsb\n",
    "importlib.reload(gpsb)\n",
    "\n",
    "SRT_PATH = DATA_DIR / 'gps_data.SRT'\n",
    "GOOD_M   = 15.0   # a fix counts as correct within this many metres of truth\n",
    "\n",
    "if not SRT_PATH.exists():\n",
    "    print(f'No SRT at {SRT_PATH} -- skipping GPS benchmark')\n",
    "elif not anchors:\n",
    "    print('No anchors to benchmark')\n",
    "else:\n",
    "    fixes = gpsb.parse_dji_srt(SRT_PATH, nominal_lat=LAT, nominal_lon=LON)\n",
    "    span = (fixes[-1].t_ms - fixes[0].t_ms) / 1000.0\n",
    "    print(f'Parsed {len(fixes)} GPS fixes from SRT ({span:.1f} s span)')\n",
    "\n",
    "    # frame_idx -> video timestamp (ms). Extrapolates the 15 Hz cadence if only\n",
    "    # a subset of frames is on disk (logs may reference frame_idx beyond them).\n",
    "    max_idx   = max(a['frame_idx'] for a in anchors)\n",
    "    frame_ts  = gpsb.load_frame_timestamps(FRAMES_DIR, n_needed=max_idx + 1)\n",
    "\n",
    "    estimates = [(a['frame_idx'], a['est_lat'], a['est_lon']) for a in anchors]\n",
    "    scored, summary = gpsb.benchmark_estimates(estimates, fixes, frame_ts, good_m=GOOD_M)\n",
    "    gpsb.print_summary(summary, 'satellite anchors')\n",
    "\n",
    "    out_csv = RESULTS_DIR / 'gps_benchmark_anchors.csv'\n",
    "    out_png = RESULTS_DIR / 'gps_benchmark_anchors.png'\n",
    "    gpsb.write_scored_csv(scored, out_csv)\n",
    "    gpsb.plot_report(scored, fixes, summary, out_png, title='Satellite anchors vs DJI GPS')\n",
    "    print(f'\\nWrote {out_csv}')\n",
    "    print(f'Wrote {out_png}')\n",
    "\n",
    "    # Attach truth error back onto each anchor for downstream filtering/plots.\n",
    "    err_by_frame = {s.frame_idx: s.error_m for s in scored}\n",
    "    for a in anchors:\n",
    "        a['truth_error_m'] = err_by_frame.get(a['frame_idx'])\n"
   ]
  },
