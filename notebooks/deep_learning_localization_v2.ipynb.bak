    "import sys, importlib\n",
    "sys.path.append('../code')\n",
    "import manual_anchors as ma, gps_benchmark as gpsb\n",
    "importlib.reload(ma); importlib.reload(gpsb)\n",
    "import numpy as np\n",
    "\n",
    "# frame_idx: (lat, lon) -- aim for ~8-15 well-spread frames, marked within a few metres.\n",
    "MANUAL_ANCHORS = {\n",
    "    3077: (43.521987, -5.625571),\n",
    "    3429: (43.522246, -5.625259),\n",
    "    2868: (43.521931, -5.625265),\n",
    "    2700: (43.521811, -5.625056),\n",
    "    2600: (43.521761, -5.624862),\n",
    "    2400: (43.521651, -5.624585),\n",
    "    2300: (43.521562, -5.624634),\n",
    "    1900: (43.521204, -5.624432),\n",
    "    1300: (43.521378, -5.623308),\n",
    "    1000: (43.521720, -5.623060),\n",
    "    650: (43.522219, -5.623394),\n",
    "    450: (43.522137, -5.623678),\n",
    "    300: (43.522084, -5.623962),\n",
    "    200: (43.521958, -5.624280)\n",
    "}\n",
    "\n",
    "# Optional: click locations on the satellite tile instead of typing them.\n",
    "#   %matplotlib widget\n",
    "#   suggest = [vo_records[i]['frame_idx'] for i in np.linspace(0, len(vo_records)-1, 10).astype(int)]\n",
    "#   MANUAL_ANCHORS = ma.click_anchors_on_tile(sat_tile, bbox_sat, suggest, frame_paths)\n",
    "\n",
    "if len(MANUAL_ANCHORS) < 2:\n",
    "    suggest = [vo_records[i]['frame_idx'] for i in np.linspace(0, len(vo_records)-1, 10).astype(int)]\n",
    "    print('Add >= 2 manual anchors to MANUAL_ANCHORS to enable manual fusion.')\n",
    "    print(f'Suggested well-spread frames to mark: {suggest}')\n",
    "else:\n",
    "    manual_anchor_list = ma.make_manual_anchors(MANUAL_ANCHORS, vo_records)\n",
    "    world_fit = ma.fit_vo_to_world(manual_anchor_list)\n",
    "    print(f'VO->world fit: scale={world_fit.scale_m_per_px:.4f} m/px  '\n",
    "          f'rotation={world_fit.rotation_deg:.1f} deg  reflected={world_fit.reflected}  '\n",
    "          f'anchor residual={world_fit.residual_m:.1f} m  (n={world_fit.n})')\n",
    "\n",
    "    fused_gps_track = ma.fuse_vo_with_anchors(vo_records, manual_anchor_list, world_fit)\n",
    "\n",
    "    # Validate against DJI GPS truth (QA only).\n",
    "    srt = DATA_DIR / 'gps_data.SRT'\n",
    "    if srt.exists():\n",
    "        fixes = gpsb.parse_dji_srt(srt, nominal_lat=LAT, nominal_lon=LON)\n",
    "        ft = gpsb.load_frame_timestamps(FRAMES_DIR, n_needed=vo_records[-1]['frame_idx'] + 1)\n",
    "        _, summ = gpsb.benchmark_estimates(fused_gps_track, fixes, ft, good_m=15.0)\n",
    "        gpsb.print_summary(summ, 'manual-anchored fused trajectory')\n",
    "\n",
    "    # Dashboard: fused GPS path over the satellite tile.\n",
    "    if sat_tile is not None and bbox_sat is not None:\n",
    "        import matplotlib.pyplot as plt\n",
    "        lat_min, lat_max, lon_min, lon_max = bbox_sat\n",
    "        h, w = sat_tile.shape[:2]\n",
    "        def to_px(lat, lon):\n",
    "            return ((lon - lon_min)/(lon_max - lon_min)*w,\n",
    "                    (lat_max - lat)/(lat_max - lat_min)*h)\n",
    "        fig, ax = plt.subplots(figsize=(9, 9))\n",
    "        ax.imshow(sat_tile, extent=[0, w, h, 0])\n",
    "        xs = [to_px(p[1], p[2])[0] for p in fused_gps_track]\n",
    "        ys = [to_px(p[1], p[2])[1] for p in fused_gps_track]\n",
    "        ax.plot(xs, ys, '-', c='cyan', lw=1.5, label='fused path')\n",
    "        for a in manual_anchor_list:\n",
    "            mx, my = to_px(a['est_lat'], a['est_lon'])\n",
    "            ax.plot(mx, my, 'o', c='yellow', ms=8, mec='k', label='manual anchor')\n",
    "        ax.set_xlim(0, w); ax.set_ylim(h, 0); ax.axis('off')\n",
    "        ax.set_title('Manual-anchored flight path over satellite')\n",
    "        by = dict(zip(*reversed(ax.get_legend_handles_labels())))\n",
    "        ax.legend(by.keys(), by.values())\n",
    "        plt.tight_layout()\n",
    "        fig.savefig(RESULTS_DIR / 'manual_anchored_dashboard.png', dpi=130, bbox_inches='tight')\n",
    "        plt.show()\n"
   ]
