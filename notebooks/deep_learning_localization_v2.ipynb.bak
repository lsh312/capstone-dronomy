    "%matplotlib inline\n",
    "import sys; sys.path.append('../code')\n",
    "import numpy as np, matplotlib.pyplot as plt\n",
    "from PIL import Image\n",
    "\n",
    "N_SCOUT = 40\n",
    "idxs = np.linspace(0, len(frame_paths) - 1, N_SCOUT).astype(int)\n",
    "\n",
    "# Altitude labels are a nice-to-have; never let them break the scout.\n",
    "alts = {}\n",
    "try:\n",
    "    import gps_benchmark as gpsb\n",
    "    srt = DATA_DIR / 'gps_data.SRT'\n",
    "    if srt.exists():\n",
    "        fixes = gpsb.parse_dji_srt(srt)\n",
    "        ft = gpsb.load_frame_timestamps(FRAMES_DIR, n_needed=int(idxs.max()) + 1)\n",
    "        T = np.array([f.t_ms for f in fixes], float)\n",
    "        A = np.array([f.alt for f in fixes], float)\n",
    "        alts = {int(i): float(np.interp(ft[i], T, A)) for i in idxs}\n",
    "except Exception as e:\n",
    "    print(f'(altitude labels unavailable: {e})')\n",
    "\n",
    "cols = 5\n",
    "rows = int(np.ceil(N_SCOUT / cols))\n",
    "fig, axes = plt.subplots(rows, cols, figsize=(cols * 3, rows * 2.2))\n",
    "for ax, i in zip(axes.ravel(), idxs):\n",
    "    ax.imshow(Image.open(frame_paths[int(i)]))\n",
    "    label = f'frame {int(i)}' + (f'  {alts[int(i)]:.0f} m' if int(i) in alts else '')\n",
    "    ax.set_title(label, fontsize=8)\n",
    "    ax.axis('off')\n",
    "for ax in axes.ravel()[len(idxs):]:\n",
